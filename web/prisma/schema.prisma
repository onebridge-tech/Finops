// Phase 1 data model. PostgreSQL (PRD 10.2). Money is always stored as
// integer paise (BigInt) — never floating point.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(cuid())
  // A person signs in with their email and password, or Google. `phone` is only set on older accounts
  // that signed in with a phone code; `mobile` is the number given at registration and is not verified yet.
  phone        String?      @unique
  mobile       String?
  mobileVerifiedAt DateTime?
  // scrypt hash of the password; sign-in is refused until the email is verified.
  passwordHash String?
  passwordChangedAt DateTime?
  email        String?
  googleSub    String?
  emailVerifiedAt DateTime?
  name         String?
  // App lock (SE-03): scrypt hash of a 4–6 digit PIN; lock after this many idle minutes.
  pinHash      String?
  lockAfterMin Int          @default(5)
  uiLanguage   String       @default("en") // LO-01 app language
  uiMode       String       @default("SIMPLE") // LO-02 SIMPLE | ACCOUNTANT
  createdAt    DateTime     @default(now())
  memberships  Membership[]
  sessions     Session[]
}

// One signed-in device (SE-03). The cookie holds only the signed session id, so
// a session can be listed, locked and revoked from the server.
model Session {
  id           String    @id @default(cuid())
  userId       String
  businessId   String? // active business
  branchId     String? // active branch for users not tied to one; null = all branches
  userAgent    String?
  ip           String?
  createdAt    DateTime  @default(now())
  lastActiveAt DateTime  @default(now())
  expiresAt    DateTime
  lockedAt     DateTime?
  pinFailures  Int       @default(0)
  revokedAt    DateTime?
  user         User      @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Branch {
  id         String    @id @default(cuid())
  businessId String
  name       String
  address    String?
  phone      String?
  createdAt  DateTime  @default(now())
  archivedAt DateTime?
  business   Business  @relation(fields: [businessId], references: [id])

  // Own GSTIN and invoice series for this branch (BD-10)
  gstin         String?
  stateCode     String?
  invoicePrefix String?
  nextInvoiceNo Int     @default(1)

  @@index([businessId])
}

model OtpCode {
  id         String    @id @default(cuid())
  phone      String? // a code is sent either to a phone ...
  email      String? // ... or to an email address
  purpose    String    @default("LOGIN") // SIGNUP | RESET | LINK (LOGIN on older codes); a code only works for its purpose
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
  @@index([email, createdAt])
}

// Money in and out as the bank or UPI statement shows it (STAGE M).
model Statement {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  fileName    String?
  fromDate    DateTime?
  toDate      DateTime?
  rows        Int      @default(0)
  imported    Int      @default(0)
  duplicates  Int      @default(0)
  createdById String
  createdAt   DateTime @default(now())

  @@index([businessId, createdAt])
}

model BankTxn {
  id           String   @id @default(cuid())
  businessId   String
  statementId  String?
  date         DateTime
  description  String
  direction    String // IN | OUT
  amountPaise  BigInt
  balancePaise BigInt?
  ref          String?
  category     String
  manual       Boolean  @default(false) // the shop chose this group itself
  counterparty String?
  expenseId    String? // set when it was added to the shop's expenses
  entryId      String? // set when it was recorded as a customer's payment
  hash         String
  createdAt    DateTime @default(now())

  @@unique([businessId, hash])
  @@index([businessId, date])
}

// "Anything from Ravi Traders is Rent": a correction the shop made once and wants remembered.
model CategoryRule {
  id         String   @id @default(cuid())
  businessId String
  keyword    String
  category   String
  direction  String?
  createdAt  DateTime @default(now())

  @@unique([businessId, keyword])
}

// A shop's own wording for a message (STAGE W). Without a row the built-in text is used.
model MessageTemplate {
  id          String   @id @default(cuid())
  businessId  String
  kind        String // REMINDER | ENTRY_GAVE | ENTRY_GOT | RECEIPT | INVOICE | QUOTE | STATEMENT | INVITE
  lang        String
  body        String
  updatedById String?
  updatedAt   DateTime @updatedAt

  @@unique([businessId, kind, lang])
}

// Server problems, one row per kind of problem with a count (STAGE C).
model ErrorLog {
  id          String    @id @default(cuid())
  fingerprint String    @unique
  kind        String // SERVER | ACTION | ROUTE | CLIENT
  route       String
  method      String?
  message     String
  stack       String?
  digest      String?
  count       Int       @default(1)
  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  resolvedAt  DateTime?

  @@index([lastSeenAt])
}

// One run of a scheduled job (reminders, daily summary, backup).
model JobRun {
  id         String    @id @default(cuid())
  name       String
  source     String    @default("scheduler") // scheduler | cron
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  ok         Boolean?
  summary    String?
  error      String?

  @@index([name, startedAt])
}

// What platform admins looked at or changed (separate from each shop's own audit trail).
// Settings the platform admin fills in from the admin area (for example the company details shown on the legal pages).
model SiteSetting {
  key         String   @id
  value       String
  updatedAt   DateTime @updatedAt
  updatedById String?
}

model PlatformAudit {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  target    String?
  data      String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Business {
  id                     String         @id @default(cuid())
  name                   String
  // Set by a platform admin. While set, nobody can use the shop and nothing is sent on its behalf.
  suspendedAt            DateTime?
  suspendedReason        String?
  suspendedById          String?
  gstin                  String?
  stateCode              String // 2-digit GST state code
  address                String?
  phone                  String?
  email                  String?
  upiId                  String?
  referralCode           String?        @unique // EC-03 invite link code
  referredById           String? // business whose invite brought this one
  invoicePrefix          String         @default("INV-")
  nextInvoiceNo          Int            @default(1)
  receiptPrefix          String         @default("RCPT-")
  nextReceiptNo          Int            @default(1)
  quotePrefix            String         @default("QT-")
  nextQuoteNo            Int            @default(1)
  // Branding on documents (BD-04)
  logoFileId             String?
  signatureFileId        String?
  brandColor             String         @default("#0f766e")
  docTemplate            String         @default("CLASSIC") // CLASSIC | MODERN | COMPACT
  docTerms               String?
  bankName               String?
  bankAccountName        String?
  bankAccountNo          String?
  bankIfsc               String?
  creditBalance          Int            @default(0) // messaging credits (CP-12)
  autoReceipt            Boolean        @default(true) // CP-11: send a receipt for every payment
  entryConfirm           Boolean        @default(false) // LG-02: default for "notify party" on new entries
  // Default auto-reminder rule (CP-02). Parties can override it.
  reminderEnabled        Boolean        @default(false)
  reminderDaysBefore     Int?           @default(3)
  reminderOnDue          Boolean        @default(true)
  reminderEveryDaysAfter Int?           @default(7)
  reminderChannel        String         @default("WHATSAPP") // WHATSAPP | SMS | EMAIL
  createdAt              DateTime       @default(now())
  memberships            Membership[]
  parties                Party[]
  items                  Item[]
  invoices               Invoice[]
  entries                LedgerEntry[]
  messages               Message[]
  auditEvents            AuditEvent[]
  creditTxns             CreditTxn[]
  consentEvents          ConsentEvent[]
  receipts               Receipt[]
  followUps              FollowUp[]
  files                  StoredFile[]
  quotes                 Quote[]
  branches               Branch[]

  // Phase 2
  creditControl      String           @default("WARN") // OFF | WARN | BLOCK  (CP-07)
  creditBlockOverdue Boolean          @default(false) // also act when the party has overdue bills
  cashOpeningPaise   BigInt           @default(0) // cash in hand when the cashbook starts (LG-08)
  digestFrequency    String           @default("OFF") // OFF | DAILY | WEEKLY (IR-09)
  digestChannel      String           @default("WHATSAPP")
  catalogToken       String?          @unique // public catalogue link (CI-02)
  catalogEnabled     Boolean          @default(false)
  orderPrefix        String           @default("SO-")
  nextOrderNo        Int              @default(1)
  poPrefix           String           @default("PO-")
  nextPoNo           Int              @default(1)
  creditNotePrefix   String           @default("CN-")
  nextCreditNoteNo   Int              @default(1)
  debitNotePrefix    String           @default("DN-")
  nextDebitNoteNo    Int              @default(1)
  tallyKeyHash       String? // connector API key (IN-01), stored hashed
  tallyLastSyncAt    DateTime?
  expenses           Expense[]
  purchaseBills      PurchaseBill[]
  cashSales          CashSale[]
  noteScans          NoteScan[]
  cashAdjustments    CashAdjustment[]
  dayCloses          DayClose[]
  orders             Order[]
  notes              Note[]
  priceLists         PriceList[]
  stockMovements     StockMovement[]
  visits             Visit[]
  beats              Beat[]
  targets            Target[]
  attendances        Attendance[]
  promises           PromiseToPay[]
  allocations        Allocation[]
  payments           Payment[]
  tallySyncs         TallySync[]
}

model Membership {
  id             String   @id @default(cuid())
  userId         String
  businessId     String
  role           String // OWNER | ADMIN | ACCOUNTANT | BILLING | REP | VIEWER
  // Data scoping (SE-01)
  branchId       String? // tied to one branch; null = all branches
  partyScope     String   @default("ALL") // ALL | ASSIGNED (only parties assigned to this user)
  dashboardTiles String? // JSON list of dashboard tile ids in order (IR-01); null = default
  maxDiscountBp  Int? // largest line discount this member may give; null = no limit
  invitedById    String?
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id])
  business       Business @relation(fields: [businessId], references: [id])

  @@unique([userId, businessId])
}

model Party {
  id                     String         @id @default(cuid())
  businessId             String
  name                   String
  type                   String         @default("CUSTOMER") // CUSTOMER | SUPPLIER | BOTH
  phone                  String?
  email                  String?
  gstin                  String?
  stateCode              String?
  address                String?
  creditDays             Int?
  language               String         @default("en")
  source                 String?
  branchId               String? // home branch; null = shared by all branches
  ownerId                String? // team member this party is assigned to (rep)
  shareToken             String         @unique
  // Messaging consent (SE-06). consentAt = the business attests the party agreed to receive messages.
  consentAt              DateTime?
  whatsappOptOutAt       DateTime?
  smsOptOutAt            DateTime?
  emailOptOutAt          DateTime?
  disputedAt             DateTime? // pauses auto-reminders
  // Auto-reminder override (CP-02). DEFAULT follows the business rule.
  reminderMode           String         @default("DEFAULT") // DEFAULT | CUSTOM | OFF
  reminderDaysBefore     Int?
  reminderOnDue          Boolean?
  reminderEveryDaysAfter Int?
  reminderChannel        String?
  lastAutoReminderAt     DateTime?
  createdAt              DateTime       @default(now())
  archivedAt             DateTime?
  business               Business       @relation(fields: [businessId], references: [id])
  entries                LedgerEntry[]
  invoices               Invoice[]
  messages               Message[]
  consentEvents          ConsentEvent[]
  receipts               Receipt[]
  quotes                 Quote[]
  followUps              FollowUp[]

  creditLimitPaise    BigInt?
  reminderSnoozeUntil DateTime? // set by a promise-to-pay (CP-09)
  priceListId         String? // CI-03
  lat                 Float? // saved customer location (FS-01)
  lng                 Float?
  linkedBusinessId    String? // counterpart business on the platform (LG-10)

  @@index([businessId, name])
}

// Append-only. Corrections are made with a REVERSAL entry, never by update/delete.
// Sign convention: GAVE increases what the party owes us, GOT decreases it.
model LedgerEntry {
  id           String       @id @default(cuid())
  businessId   String
  partyId      String
  direction    String // GAVE | GOT
  amountPaise  BigInt
  date         DateTime
  dueDate      DateTime?
  note         String?
  source       String       @default("MANUAL") // MANUAL | OPENING | INVOICE | REVERSAL
  invoiceId    String?
  branchId     String?
  paymentMode  String? // GOT entries: CASH | UPI | BANK | CHEQUE | CARD | OTHER
  reversalOfId String?      @unique
  createdById  String
  createdAt    DateTime     @default(now())
  business     Business     @relation(fields: [businessId], references: [id])
  party        Party        @relation(fields: [partyId], references: [id])
  reversalOf   LedgerEntry? @relation("Reversal", fields: [reversalOfId], references: [id])
  reversedBy   LedgerEntry? @relation("Reversal")
  receipt      Receipt?

  @@index([businessId, partyId, date])
}

model Item {
  id                 String    @id @default(cuid())
  businessId         String
  name               String
  description        String?
  sku                String?
  unit               String    @default("pcs")
  pricePaise         BigInt // sale price, excluding GST
  purchasePricePaise BigInt?
  hsn                String?
  taxRateBp          Int       @default(1800) // basis points: 1800 = 18%
  isPublic           Boolean   @default(false) // shown in the shareable catalogue (CI-02)
  imageFileId        String?
  parentId           String? // set on a variant; the parent is the base product
  variantName        String? // e.g. "Red / XL"
  createdAt          DateTime  @default(now())
  archivedAt         DateTime?
  business           Business  @relation(fields: [businessId], references: [id])
  parent             Item?     @relation("Variants", fields: [parentId], references: [id])
  variants           Item[]    @relation("Variants")

  category          String?
  trackStock        Boolean   @default(false)
  reorderLevelMilli Int?
  lowStockAlertedAt DateTime?

  @@index([businessId, name])
}

// Uploaded file (logo, signature, item image, entry attachment). Bytes live in storage.
model StoredFile {
  id          String   @id @default(cuid())
  businessId  String
  kind        String // LOGO | SIGNATURE | ITEM_IMAGE | ATTACHMENT
  name        String
  mime        String
  size        Int
  storageKey  String
  entryId     String?
  createdById String
  createdAt   DateTime @default(now())
  business    Business @relation(fields: [businessId], references: [id])

  expenseId String?
  visitId   String?

  @@index([businessId, kind])
  @@index([entryId])
}

model Quote {
  id                 String      @id @default(cuid())
  businessId         String
  partyId            String
  number             String
  date               DateTime
  validUntil         DateTime?
  placeOfSupply      String
  interState         Boolean
  taxablePaise       BigInt
  cgstPaise          BigInt
  sgstPaise          BigInt
  igstPaise          BigInt
  roundOffPaise      BigInt
  totalPaise         BigInt
  status             String      @default("OPEN") // OPEN | ACCEPTED | DECLINED | CONVERTED
  notes              String?
  branchId           String?
  shareToken         String      @unique
  viewCount          Int         @default(0)
  firstViewedAt      DateTime?
  lastViewedAt       DateTime?
  respondedAt        DateTime?
  responderName      String?
  convertedInvoiceId String?
  createdById        String
  createdAt          DateTime    @default(now())
  business           Business    @relation(fields: [businessId], references: [id])
  party              Party       @relation(fields: [partyId], references: [id])
  lines              QuoteLine[]

  @@unique([businessId, number])
}

model QuoteLine {
  id           String  @id @default(cuid())
  quoteId      String
  itemId       String?
  description  String
  hsn          String?
  qtyMilli     Int
  unit         String
  ratePaise    BigInt
  discountBp   Int     @default(0) // line discount in basis points of the gross amount
  taxRateBp    Int
  taxablePaise BigInt
  cgstPaise    BigInt
  sgstPaise    BigInt
  igstPaise    BigInt
  totalPaise   BigInt
  quote        Quote   @relation(fields: [quoteId], references: [id])
}

model Invoice {
  id            String        @id @default(cuid())
  businessId    String
  partyId       String
  number        String
  date          DateTime
  dueDate       DateTime?
  placeOfSupply String
  interState    Boolean
  taxablePaise  BigInt
  cgstPaise     BigInt
  sgstPaise     BigInt
  igstPaise     BigInt
  roundOffPaise BigInt
  totalPaise    BigInt
  status        String        @default("ISSUED") // ISSUED | CANCELLED
  notes         String?
  branchId      String?
  shareToken    String        @unique
  viewCount     Int           @default(0)
  firstViewedAt DateTime?
  lastViewedAt  DateTime?
  cancelledAt   DateTime?
  cancelReason  String?
  quoteId       String?
  createdById   String
  createdAt     DateTime      @default(now())
  business      Business      @relation(fields: [businessId], references: [id])
  party         Party         @relation(fields: [partyId], references: [id])
  lines         InvoiceLine[]

  sellerGstin     String? // GSTIN the invoice was issued under (BD-10)
  sellerStateCode String?
  orderId         String?

  @@unique([businessId, number])
}

model InvoiceLine {
  id           String  @id @default(cuid())
  invoiceId    String
  itemId       String?
  description  String
  hsn          String?
  qtyMilli     Int // quantity × 1000
  unit         String
  ratePaise    BigInt
  discountBp   Int     @default(0) // line discount in basis points of the gross amount
  taxRateBp    Int
  taxablePaise BigInt
  cgstPaise    BigInt
  sgstPaise    BigInt
  igstPaise    BigInt
  totalPaise   BigInt
  invoice      Invoice @relation(fields: [invoiceId], references: [id])
}

// Every outbound message, whichever provider sent it (WhatsApp link, test mode, WhatsApp API, SMS, email).
model Message {
  id                String    @id @default(cuid())
  businessId        String
  partyId           String?
  kind              String    @default("REMINDER") // REMINDER | ENTRY_CONFIRMATION | RECEIPT | INVOICE | QUOTE | STATEMENT | INVITE
  channel           String // WHATSAPP | SMS | EMAIL | WHATSAPP_LINK
  to                String    @default("")
  template          String
  body              String
  status            String    @default("SENT") // QUEUED | SENT | DELIVERED | READ | FAILED | SKIPPED
  provider          String    @default("link") // link | test | meta | msg91 | resend
  providerMessageId String?
  error             String?
  credits           Int       @default(0)
  trigger           String    @default("MANUAL") // MANUAL | AUTO | BULK
  createdById       String?
  createdAt         DateTime  @default(now())
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  business          Business  @relation(fields: [businessId], references: [id])
  party             Party?    @relation(fields: [partyId], references: [id])

  @@index([businessId, createdAt])
  @@index([providerMessageId])
}

// Messaging credits ledger (CP-12). balanceAfter makes the history self-checking.
model CreditTxn {
  id           String   @id @default(cuid())
  businessId   String
  delta        Int
  balanceAfter Int
  reason       String // WELCOME | TOPUP | MESSAGE | REFUND
  messageId    String?
  userId       String?
  note         String?
  createdAt    DateTime @default(now())
  business     Business @relation(fields: [businessId], references: [id])

  @@index([businessId, createdAt])
}

// Messaging consent record (SE-06, DPDP Act). Append-only.
model ConsentEvent {
  id         String   @id @default(cuid())
  businessId String
  partyId    String
  channel    String // ALL | WHATSAPP | SMS | EMAIL
  action     String // GRANTED | OPTED_OUT | OPTED_IN
  source     String // BUSINESS_ATTESTED | PUBLIC_LINK | PROVIDER
  actorId    String?
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id])
  party      Party    @relation(fields: [partyId], references: [id])

  @@index([partyId, createdAt])
}

// Payment receipt issued for a money-in entry (CP-11).
model Receipt {
  id          String      @id @default(cuid())
  businessId  String
  partyId     String
  entryId     String      @unique
  number      String
  amountPaise BigInt
  date        DateTime
  mode        String?
  branchId    String?
  shareToken  String      @unique
  createdAt   DateTime    @default(now())
  business    Business    @relation(fields: [businessId], references: [id])
  party       Party       @relation(fields: [partyId], references: [id])
  entry       LedgerEntry @relation(fields: [entryId], references: [id])

  @@unique([businessId, number])
}

// Write-once audit trail of every change to financial records (PRD SE-02).
// Tamper-evident audit trail (SE-02): each event stores the hash of the previous
// one for the business, so any later edit or deletion breaks the chain.
model AuditEvent {
  id         String   @id @default(cuid())
  businessId String
  seq        Int? // position in the business's chain; null only for events written before chaining
  actorId    String
  action     String
  entity     String
  entityId   String
  data       String?
  prevHash   String?
  hash       String?
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id])

  @@unique([businessId, seq])
  @@index([businessId, entity, entityId])
}

// Follow-up task on a party or lead (FS-06).
model FollowUp {
  id           String    @id @default(cuid())
  businessId   String
  partyId      String
  assignedToId String
  dueAt        DateTime
  note         String
  outcome      String?
  doneAt       DateTime?
  doneById     String?
  createdById  String
  createdAt    DateTime  @default(now())
  business     Business  @relation(fields: [businessId], references: [id])
  party        Party     @relation(fields: [partyId], references: [id])

  source String @default("MANUAL") // MANUAL | PROMISE | INACTIVE

  @@index([businessId, assignedToId, doneAt, dueAt])
  @@index([partyId])
}

// ── Phase 2 ──────────────────────────────────────────────────────────────────

// A receipt (GOT entry) assigned to specific bills (CP-10). Whatever isn't assigned
// settles the oldest dues first.
model Allocation {
  id             String   @id @default(cuid())
  businessId     String
  partyId        String
  receiptEntryId String
  invoiceEntryId String
  amountPaise    BigInt
  createdById    String
  createdAt      DateTime @default(now())
  business       Business @relation(fields: [businessId], references: [id])

  @@index([partyId])
  @@index([receiptEntryId])
}

model PromiseToPay {
  id          String   @id @default(cuid())
  businessId  String
  partyId     String
  amountPaise BigInt?
  promisedFor DateTime
  note        String?
  followUpId  String?
  createdById String
  createdAt   DateTime @default(now())
  business    Business @relation(fields: [businessId], references: [id])

  @@index([businessId, partyId])
}

model Expense {
  id          String    @id @default(cuid())
  businessId  String
  branchId    String?
  date        DateTime
  amountPaise BigInt
  category    String
  paymentMode String // CASH | UPI | BANK | CHEQUE | CARD | OTHER
  note        String?
  vendorId    String? // supplier party
  voidedAt    DateTime?
  voidReason  String?
  createdById String
  createdAt   DateTime  @default(now())
  business    Business  @relation(fields: [businessId], references: [id])

  @@index([businessId, date])
}

// A bill from a supplier, kept so the input tax credit (ITC) can be claimed and the GST return can be prepared.
// It is a tax record: it does not move money. "expenseId" links the expense that counts it in profit, if any.
model PurchaseBill {
  id            String    @id @default(cuid())
  businessId    String
  branchId      String?
  partyId       String? // supplier in the party list, if chosen
  supplierName  String
  supplierGstin String?
  number        String // the supplier's bill number
  date          DateTime
  stateCode     String? // supplier's state (place of supply for the bill)
  interState    Boolean   @default(false)
  taxablePaise  BigInt
  cgstPaise     BigInt    @default(0)
  sgstPaise     BigInt    @default(0)
  igstPaise     BigInt    @default(0)
  totalPaise    BigInt
  kind          String    @default("GOODS") // GOODS | SERVICES | CAPITAL
  itcEligible   Boolean   @default(true)
  note          String?
  expenseId     String?
  voidedAt      DateTime?
  voidReason    String?
  createdById   String
  createdAt     DateTime  @default(now())
  business      Business  @relation(fields: [businessId], references: [id])

  @@index([businessId, date])
  @@index([businessId, supplierGstin, number])
}

// A sale with no customer name, typed in or read from a photo of a paper note (cash sale, "walk-in").
model CashSale {
  id          String    @id @default(cuid())
  businessId  String
  branchId    String?
  date        DateTime
  item        String
  qtyMilli    Int?
  amountPaise BigInt
  paymentMode String    @default("CASH")
  partyId     String? // filled when the sale is later given to a customer
  source      String    @default("MANUAL") // MANUAL | NOTE_PHOTO | IMPORT
  noteScanId  String?
  voidedAt    DateTime?
  voidReason  String?
  createdById String
  createdAt   DateTime  @default(now())
  business    Business  @relation(fields: [businessId], references: [id])

  @@index([businessId, date])
  @@index([noteScanId])
}

// One photo of a paper note that was read by the AI, kept so it is never read or saved twice.
model NoteScan {
  id          String    @id @default(cuid())
  businessId  String
  fileId      String? // the stored photo
  imageHash   String
  status      String    @default("READ") // READ | SAVED | FAILED
  rowsJson    String?
  rowsSaved   Int       @default(0)
  error       String?
  createdById String
  createdAt   DateTime  @default(now())
  savedAt     DateTime?
  business    Business  @relation(fields: [businessId], references: [id])

  @@index([businessId, createdAt])
  @@index([businessId, imageHash])
}

model CashAdjustment {
  id          String    @id @default(cuid())
  businessId  String
  branchId    String?
  date        DateTime
  direction   String // IN | OUT
  amountPaise BigInt
  note        String
  voidedAt    DateTime?
  createdById String
  createdAt   DateTime  @default(now())
  business    Business  @relation(fields: [businessId], references: [id])

  @@index([businessId, date])
}

// Counted cash against expected at the end of a day (LG-08).
model DayClose {
  id              String   @id @default(cuid())
  businessId      String
  branchKey       String // branch id, or ALL
  date            String // yyyy-mm-dd (IST)
  expectedPaise   BigInt
  countedPaise    BigInt
  differencePaise BigInt
  note            String?
  closedById      String
  createdAt       DateTime @default(now())
  business        Business @relation(fields: [businessId], references: [id])

  @@unique([businessId, branchKey, date])
}

model Order {
  id            String      @id @default(cuid())
  businessId    String
  branchId      String?
  kind          String // SALES | PURCHASE
  number        String
  partyId       String
  date          DateTime
  expectedDate  DateTime?
  status        String      @default("OPEN") // REQUEST | OPEN | PARTIAL | FULFILLED | CANCELLED
  source        String      @default("MANUAL") // MANUAL | CATALOGUE | VISIT | QUOTE
  visitId       String?
  quoteId       String?
  placeOfSupply String
  interState    Boolean
  taxablePaise  BigInt
  cgstPaise     BigInt
  sgstPaise     BigInt
  igstPaise     BigInt
  roundOffPaise BigInt
  totalPaise    BigInt
  notes         String?
  shareToken    String      @unique
  createdById   String?
  createdAt     DateTime    @default(now())
  business      Business    @relation(fields: [businessId], references: [id])
  lines         OrderLine[]

  @@unique([businessId, kind, number])
  @@index([businessId, status])
}

model OrderLine {
  id             String  @id @default(cuid())
  orderId        String
  itemId         String?
  description    String
  hsn            String?
  qtyMilli       Int
  fulfilledMilli Int     @default(0)
  unit           String
  ratePaise      BigInt
  discountBp     Int     @default(0)
  taxRateBp      Int
  taxablePaise   BigInt
  cgstPaise      BigInt
  sgstPaise      BigInt
  igstPaise      BigInt
  totalPaise     BigInt
  order          Order   @relation(fields: [orderId], references: [id])
}

// Credit note (sales return / discount after sale) or debit note (BD-06).
model Note {
  id            String     @id @default(cuid())
  businessId    String
  branchId      String?
  kind          String // CREDIT | DEBIT
  number        String
  partyId       String
  invoiceId     String?
  date          DateTime
  reason        String
  placeOfSupply String
  interState    Boolean
  taxablePaise  BigInt
  cgstPaise     BigInt
  sgstPaise     BigInt
  igstPaise     BigInt
  roundOffPaise BigInt
  totalPaise    BigInt
  status        String     @default("ISSUED")
  shareToken    String     @unique
  createdById   String
  createdAt     DateTime   @default(now())
  business      Business   @relation(fields: [businessId], references: [id])
  lines         NoteLine[]

  @@unique([businessId, kind, number])
}

model NoteLine {
  id            String  @id @default(cuid())
  noteId        String
  itemId        String?
  description   String
  hsn           String?
  qtyMilli      Int
  unit          String
  ratePaise     BigInt
  discountBp    Int     @default(0)
  taxRateBp     Int
  taxablePaise  BigInt
  cgstPaise     BigInt
  sgstPaise     BigInt
  igstPaise     BigInt
  totalPaise    BigInt
  returnToStock Boolean @default(true)
  note          Note    @relation(fields: [noteId], references: [id])
}

model PriceList {
  id         String          @id @default(cuid())
  businessId String
  name       String
  createdAt  DateTime        @default(now())
  archivedAt DateTime?
  business   Business        @relation(fields: [businessId], references: [id])
  items      PriceListItem[]

  @@index([businessId])
}

// A rate for an item on a price list; minQtyMilli > 0 makes it a quantity slab (CI-03).
model PriceListItem {
  id          String    @id @default(cuid())
  priceListId String
  itemId      String
  minQtyMilli Int       @default(0)
  ratePaise   BigInt
  priceList   PriceList @relation(fields: [priceListId], references: [id])

  @@unique([priceListId, itemId, minQtyMilli])
}

// Stock is the sum of signed movements (CI-04). Never edited; corrected with a new movement.
model StockMovement {
  id          String   @id @default(cuid())
  businessId  String
  branchId    String?
  itemId      String
  qtyMilli    Int
  reason      String // INVOICE | PURCHASE | RETURN | ADJUSTMENT | OPENING | CANCEL
  refType     String?
  refId       String?
  note        String?
  createdById String?
  createdAt   DateTime @default(now())
  business    Business @relation(fields: [businessId], references: [id])

  @@index([businessId, itemId])
}

model Visit {
  id          String    @id @default(cuid())
  businessId  String
  branchId    String?
  partyId     String
  userId      String
  clientId    String?   @unique // set by offline clients so a retried upload isn't duplicated
  checkInAt   DateTime
  inLat       Float?
  inLng       Float?
  inAccuracy  Float?
  distanceM   Int? // from the customer's saved location at check-in
  photoFileId String?
  note        String?
  outcome     String?
  checkOutAt  DateTime?
  outLat      Float?
  outLng      Float?
  createdAt   DateTime  @default(now())
  business    Business  @relation(fields: [businessId], references: [id])

  @@index([businessId, userId, checkInAt])
  @@index([partyId])
}

model Beat {
  id         String      @id @default(cuid())
  businessId String
  name       String
  userId     String // the rep who walks it
  weekdays   String // comma list, 0 = Sunday … 6 = Saturday
  archivedAt DateTime?
  createdAt  DateTime    @default(now())
  business   Business    @relation(fields: [businessId], references: [id])
  parties    BeatParty[]

  @@index([businessId, userId])
}

model BeatParty {
  id       String @id @default(cuid())
  beatId   String
  partyId  String
  position Int
  beat     Beat   @relation(fields: [beatId], references: [id])

  @@unique([beatId, partyId])
}

model Target {
  id         String   @id @default(cuid())
  businessId String
  userId     String
  month      String // yyyy-mm
  metric     String // VISITS | NEW_CUSTOMERS | ORDERS | COLLECTIONS | SALES
  value      BigInt // count, or paise for money metrics
  business   Business @relation(fields: [businessId], references: [id])

  @@unique([businessId, userId, month, metric])
}

model Attendance {
  id          String   @id @default(cuid())
  businessId  String
  userId      String
  date        String // yyyy-mm-dd (IST)
  checkInAt   DateTime
  lat         Float?
  lng         Float?
  photoFileId String?
  source      String // DAYSTART | VISIT
  business    Business @relation(fields: [businessId], references: [id])

  @@unique([businessId, userId, date])
}

// Online payment through a gateway (CP-05).
model Payment {
  id                String    @id @default(cuid())
  businessId        String
  partyId           String
  invoiceId         String?
  amountPaise       BigInt
  provider          String // test | razorpay | cashfree
  providerOrderId   String
  providerPaymentId String?
  status            String    @default("CREATED") // CREATED | PAID | FAILED
  token             String    @unique
  entryId           String? // the ledger entry posted when paid
  createdAt         DateTime  @default(now())
  paidAt            DateTime?
  business          Business  @relation(fields: [businessId], references: [id])

  @@index([providerOrderId])
  @@index([businessId, status])
}

// Log of what the Tally connector pushed and pulled (IN-01).
model TallySync {
  id         String   @id @default(cuid())
  businessId String
  direction  String // PUSH | PULL
  kind       String // LEDGER | ITEM | VOUCHER | OUTSTANDING
  status     String // OK | FAILED | CONFLICT
  refType    String?
  refId      String?
  message    String?
  retries    Int      @default(0)
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id])

  @@index([businessId, createdAt])
}

// An entry one platform business made against another, offered to the other
// side to accept (LG-10).
model SharedEntry {
  id               String    @id @default(cuid())
  businessId       String // the business that receives the proposal
  counterpartBizId String // the business that made the entry
  sourceEntryId    String    @unique
  partyId          String // recipient's party for the counterpart
  direction        String // from the recipient's side: GAVE | GOT
  amountPaise      BigInt
  date             DateTime
  note             String?
  status           String    @default("PENDING") // PENDING | ACCEPTED | AUTO_ACCEPTED | REJECTED
  autoAcceptAt     DateTime
  entryId          String? // created on accept
  resolvedById     String?
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())

  @@index([businessId, status])
}

// An operation uploaded by an offline client (FS-08). Recording its id makes a retried upload harmless.
model ClientOp {
  id         String   @id @default(cuid())
  businessId String
  userId     String
  clientId   String   @unique
  kind       String // CHECKIN | CHECKOUT | ORDER | COLLECTION
  refId      String? // what it created
  createdAt  DateTime @default(now())

  @@index([businessId, userId])
}

// One row per attempt at something we limit (signing in, asking for a code), keyed by what is limited:
// "login:ip:1.2.3.4", "code:email:a@b.in" … Old rows are deleted as new ones are written.
model RateHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}
