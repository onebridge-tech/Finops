DATABASE_URL="postgresql://user:password@localhost:5432/ledger"
SESSION_SECRET="replace-with-32+-random-bytes"
APP_URL="http://localhost:3000"
# OTP_DEV_MODE=1 shows the login code on screen; never set in production.
OTP_DEV_MODE=1

# Cron: protects /api/cron/reminders. REMINDER_SCHEDULER=1 runs reminders hourly in-process instead.
CRON_SECRET="replace-with-random-string"
# REMINDER_SCHEDULER=1

# Messaging providers. Leave unset for TEST mode (messages are recorded, not sent).
# WHATSAPP_PROVIDER=meta
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE_PREFIX=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# SMS_PROVIDER=msg91
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_REMINDER=   (one DLT template id per message kind: REMINDER, RECEIPT, ENTRY_GAVE, ENTRY_GOT, INVOICE, QUOTE, STATEMENT, INVITE)
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# EMAIL_FROM="Your Shop <billing@yourdomain.in>"

# Files and backups
# UPLOAD_DIR=./uploads            (put on a persistent disk)
# BACKUP_DIR=./backups
# BACKUP_KEEP=14
# BACKUP_KEY="long random passphrase"   (encrypts backups; store it somewhere safe)
# BACKUP_SCHEDULER=1                    (daily backup in-process; or call /api/cron/backup)

# GSTIN lookup (IN-06). Unset = test mode with clearly labelled made-up details.
# GSTIN_PROVIDER=appyflow
# APPYFLOW_KEY=
